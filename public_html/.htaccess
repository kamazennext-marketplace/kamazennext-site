# === KZN: Route /marketplace/* to /software/software/marketplace (must be first) ===
<IfModule mod_rewrite.c>
RewriteEngine On

# If nested marketplace exists, serve it for /marketplace/*
RewriteCond %{DOCUMENT_ROOT}/software/software/marketplace/index.php -f
RewriteRule ^marketplace/?$ /software/software/marketplace/index.php [L,QSA]

RewriteCond %{DOCUMENT_ROOT}/software/software/marketplace/index.php -f
RewriteRule ^marketplace/(.*)$ /software/software/marketplace/$1 [L,QSA]

</IfModule>
# === /KZN marketplace route ===

# === KZN: allow real files & bypass loader rewrites (must be first) ===
Options -MultiViews
<IfModule mod_rewrite.c>
RewriteEngine On

# Do NOT rewrite marketplace routes
RewriteCond %{REQUEST_URI} ^/marketplace(/|$) [NC]
RewriteRule ^ - [L]

# Do NOT rewrite real existing files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>
# === /KZN bypass ===

# === KZN: bypass SPA/loader for marketplace (must be first) ===
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/marketplace(/|$) [NC]
RewriteRule .* - [L]
</IfModule>
# === /KZN marketplace bypass ===

Options -Indexes

SetEnv ADMIN_PASSWORD "CHANGE_ME_STRONG_PASSWORD"

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Force non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^category/?$ /category.html [L]
  RewriteRule ^category/([^/]+)/?$ /software.html?cat=$1 [L,QSA]

  # REVIEW: Best pages route
  RewriteRule ^best/([a-z0-9-]+)/?$ /best/page.html?s=$1 [L,QSA,NC]

  # REVIEW: Compare SEO pages route
  RewriteRule ^compare/([a-z0-9-]+)-vs-([a-z0-9-]+)/?$ /compare/page.html?a=$1&b=$2 [L,QSA,NC]
</IfModule>

<Files "contact-test.html">
  Require all denied
</Files>

<Files "probe.php">
  Require all denied
</Files>
